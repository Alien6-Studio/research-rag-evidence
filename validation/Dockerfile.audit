FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1
RUN python -m pip install --no-cache-dir numpy==2.3.4 pyarrow==23.0.1 tokenizers==0.22.1 ujson==5.13.0
WORKDIR /study
ENTRYPOINT ["python", "validation/portability.py"]
